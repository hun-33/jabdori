<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘의 일정 위젯: 날짜 · 완료 수 · 진행률 · (큰 크기) 미루먼지 한마디 · 일정 줄들 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/w_pad"
    android:paddingTop="12dp"
    android:paddingEnd="10dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/w_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_mascot"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@string/w_mireum"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/w_date"
                style="@style/WTitle"
                android:text="@string/w_today_name" />

            <TextView
                android:id="@+id/w_count"
                style="@style/WSub"
                android:layout_marginTop="1dp"
                android:text="" />
        </LinearLayout>

        <ImageView
            android:id="@+id/w_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/w_round_btn"
            android:contentDescription="@string/w_add"
            android:padding="9dp"
            android:src="@drawable/ic_w_plus" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/w_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="4dp"
        android:indeterminate="false"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/w_progress" />

    <TextView
        android:id="@+id/w_line"
        style="@style/WLine"
        android:layout_marginTop="8dp"
        android:text=""
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/w_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/w_more"
        style="@style/WSub"
        android:layout_width="match_parent"
        android:minHeight="32dp"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:text=""
        android:visibility="gone" />

    <TextView
        android:id="@+id/w_msg"
        style="@style/WLine"
        android:layout_marginTop="10dp"
        android:textColor="@color/w_ink2"
        android:text=""
        android:visibility="gone" />
</LinearLayout>
