<?xml version="1.0" encoding="utf-8"?>
<!-- 오늘의 일정 위젯 한 줄: 상태 표시(일반 일정은 누르면 체크) · 색 막대 · 제목 · 시간 · 상태 글자 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/r_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="46dp"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/r_mark"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_ring" />

    <ImageView
        android:id="@+id/r_bar"
        android:layout_width="3dp"
        android:layout_height="22dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/w_stripe" />

    <LinearLayout
        android:id="@+id/r_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/r_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/r_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_ink2"
            android:textSize="11.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/r_side"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="4dp"
        android:maxLines="1"
        android:textColor="@color/w_ink2"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
