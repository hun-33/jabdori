<?xml version="1.0" encoding="utf-8"?>
<!-- 다음 일정 위젯: 다음 일정 이름 · 시작 시각 · 남은 시간(카운트다운) · 진행 중/시작 전 일정 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="@dimen/w_pad">

    <TextView
        android:id="@+id/n_label"
        style="@style/WSub"
        android:text="@string/w_next_name" />

    <TextView
        android:id="@+id/n_title"
        style="@style/WTitle"
        android:layout_width="match_parent"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:textSize="17sp"
        android:text="" />

    <TextView
        android:id="@+id/n_when"
        style="@style/WSub"
        android:layout_marginTop="4dp"
        android:textSize="13sp"
        android:text="" />

    <LinearLayout
        android:id="@+id/n_left_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/n_left_label"
            style="@style/WSub"
            android:layout_marginEnd="4dp"
            android:textColor="@color/w_heat"
            android:textSize="13sp"
            android:text="" />

        <Chronometer
            android:id="@+id/n_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="@color/w_heat"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/n_left_text"
            style="@style/WSub"
            android:textColor="@color/w_heat"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text=""
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/n_cur"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/w_chip"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/n_cur_label"
            style="@style/WSub"
            android:textColor="@color/w_heat"
            android:textStyle="bold"
            android:text="" />

        <TextView
            android:id="@+id/n_cur_text"
            style="@style/WSub"
            android:layout_width="match_parent"
            android:textColor="@color/w_ink"
            android:text="" />
    </LinearLayout>
</LinearLayout>
