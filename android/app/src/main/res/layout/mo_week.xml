<?xml version="1.0" encoding="utf-8"?>
<!-- 달력 위젯 한 주: 아래층 = 날짜 칸(누르면 앱 달력의 그 날), 위층 = 날짜 숫자 · 막대 줄 · +N (누름은 아래층으로 통과) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <TextView android:id="@+id/c0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
        <TextView android:id="@+id/c1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
        <TextView android:id="@+id/c2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
        <TextView android:id="@+id/c3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
        <TextView android:id="@+id/c4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
        <TextView android:id="@+id/c5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
        <TextView android:id="@+id/c6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="1dp" android:layout_marginEnd="1dp" android:text="" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/mo_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:orientation="horizontal">
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d0" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d1" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d2" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d3" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d4" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d5" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1">
                <TextView android:id="@+id/d6" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_gravity="center" android:gravity="center" android:minWidth="22dp" android:paddingStart="3dp" android:paddingEnd="3dp" android:textColor="@color/w_ink" android:textSize="12sp" android:textStyle="bold" android:fontFeatureSettings="tnum" android:text="" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lanes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:orientation="horizontal">
            <TextView android:id="@+id/x0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
            <TextView android:id="@+id/x1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
            <TextView android:id="@+id/x2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
            <TextView android:id="@+id/x3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
            <TextView android:id="@+id/x4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
            <TextView android:id="@+id/x5" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
            <TextView android:id="@+id/x6" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="9sp" android:textStyle="bold" android:text="" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
