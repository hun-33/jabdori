<?xml version="1.0" encoding="utf-8"?>
<!-- 달력 위젯: 머리줄(< 11월 > · + · 오늘) · 요일 줄 · 주마다 날짜·막대 줄·+N (mo_week) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/w_bg"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingTop="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mo_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="이전 달"
            android:padding="9dp"
            android:src="@drawable/ic_w_prev" />

        <TextView
            android:id="@+id/mo_title"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:textColor="@color/w_ink"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="" />

        <ImageView
            android:id="@+id/mo_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="다음 달"
            android:padding="9dp"
            android:src="@drawable/ic_w_next" />

        <TextView
            android:id="@+id/mo_note"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="4dp"
            android:textColor="@color/w_ink2"
            android:textSize="10.5sp"
            android:text="" />

        <ImageView
            android:id="@+id/mo_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/w_add"
            android:padding="9dp"
            android:src="@drawable/ic_w_plus" />

        <FrameLayout
            android:id="@+id/mo_today_box"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="오늘로">

            <TextView
                android:id="@+id/mo_today"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:background="@drawable/mo_today_btn"
                android:gravity="center"
                android:textColor="@color/w_ink"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_sun" android:textSize="11sp" android:textStyle="bold" android:text="일" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="11sp" android:textStyle="bold" android:text="월" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="11sp" android:textStyle="bold" android:text="화" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="11sp" android:textStyle="bold" android:text="수" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="11sp" android:textStyle="bold" android:text="목" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_ink2" android:textSize="11sp" android:textStyle="bold" android:text="금" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="@color/w_sat" android:textSize="11sp" android:textStyle="bold" android:text="토" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mo_weeks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />
</LinearLayout>
