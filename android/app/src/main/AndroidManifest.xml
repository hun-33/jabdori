<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 카카오톡 앱이 설치돼 있는지 확인하기 위해 (Android 11+ 패키지 가시성) -->
    <queries>
        <package android:name="com.kakao.talk" />
        <!-- 딴짓 감지: 이 폰에 깔린 '지켜볼 앱'을 목록에 보여 주려고 (Android 11+ 패키지 가시성) -->
        <package android:name="com.google.android.youtube" />
        <package android:name="com.instagram.android" />
        <package android:name="com.zhiliaoapp.musically" />
        <package android:name="com.ss.android.ugc.trill" />
        <package android:name="com.facebook.katana" />
        <package android:name="com.twitter.android" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.nhn.android.webtoon" />
        <package android:name="com.kakao.page" />
        <package android:name="tv.twitch.android.app" />
        <package android:name="com.reddit.frontpage" />
        <package android:name="com.discord" />
        <!-- 딴짓 감지 > 지켜볼 앱: 앱 서랍에 보이는 앱 목록 (QUERY_ALL_PACKAGES 없이 런처 앱만) -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".JabdoriApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- 카카오 로그인: 카카오톡/브라우저에서 인증을 마치고 우리 앱으로 돌아오는 문 (리다이렉트 URI) -->
        <activity
            android:name="com.kakao.sdk.auth.AuthCodeHandlerActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="oauth"
                    android:scheme="kakao${KAKAO_NATIVE_APP_KEY}" />
            </intent-filter>
        </activity>

        <!-- 딴짓 감지: 잡도리 중에만 켜지는 지켜보기 서비스 (상단에 '지켜보는 중' 알림이 보임) -->
        <service
            android:name=".WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="사용자가 켠 집중 도우미: 잡도리 일정 중에 지정한 앱(유튜브 등)을 열었는지 확인해 알려 줌" />
        </service>

        <!-- 홈 화면 위젯 5종 (WidgetRender.kt): 오늘의 일정 · 다음 일정 · 미루먼지 · 잡도리 통계 · 달력 -->
        <receiver
            android:name=".TodayWidgetProvider"
            android:exported="false"
            android:label="@string/w_today_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_today_info" />
        </receiver>
        <receiver
            android:name=".NextWidgetProvider"
            android:exported="false"
            android:label="@string/w_next_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_next_info" />
        </receiver>
        <receiver
            android:name=".MireumWidgetProvider"
            android:exported="false"
            android:label="@string/w_mireum_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_mireum_info" />
        </receiver>
        <receiver
            android:name=".StatsWidgetProvider"
            android:exported="false"
            android:label="@string/w_stats_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_stats_info" />
        </receiver>
        <receiver
            android:name=".MonthWidgetProvider"
            android:exported="false"
            android:label="@string/w_month_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/w_month_info" />
        </receiver>
        <!-- 위젯 다시 그리기: 예약한 시각(앱 안 알람) · 기기 시각/시간대 변경 -->
        <receiver
            android:name=".WidgetTickReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 딴짓 감지: 어떤 앱이 앞에 열렸는지 확인 (사용자가 설정에서 직접 허용해야 함) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 딴짓 감지(선택): 허용하면 딴짓 앱 위로 잡도리 화면을 바로 불러옴 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 시작·마감 알림 (로컬 알림 플러그인이 POST_NOTIFICATIONS 등을 함께 선언함) -->
</manifest>
